# Deadline Radar config. Lives at ~/.deadline-radar/.env (never commit it).

# --- WhatsApp provider: callmebot | twilio | console ---
NOTIFY_PROVIDER=console

# CallMeBot (free, personal): https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=+91XXXXXXXXXX
CALLMEBOT_APIKEY=

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO=+91XXXXXXXXXX

# --- Behaviour ---
RADAR_TIMEZONE=Asia/Kolkata
# No alerts between these hours (they're sent at the next run). Format start-end, 24h.
RADAR_QUIET_HOURS=23-7
# Nudge about an unanswered email after this many hours
RADAR_REPLY_AFTER_HOURS=24
# Nudge about an unfilled form with no due date after this many hours
RADAR_FORM_NUDGE_HOURS=48
# Warn when this many deadlines land on the same day
RADAR_CLASH_COUNT=3
# Alert about Gmail sync failures after this many hours of failing
RADAR_HEALTH_HOURS=12
# Path to the Claude Code CLI (optional; auto-detected incl. the VS Code extension's copy)
# CLAUDE_BIN=
